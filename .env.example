# ── LLM ──────────────────────────────────────────────────────────────
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
REDIS_URL=redis://localhost:6379/0

